{
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "editor.quickSuggestions": {
    "strings": true
  },
  "tailwindCSS.experimental.configFile": "app/assets/css/main.css",
  "tailwindCSS.experimental.classRegex": [
    ["ui:\\s*{([^)]*)\\s*}", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["/\\*\\s?ui\\s?\\*/\\s*{([^;]*)}", ":\\s*[\"'`]([^\"'`]*).*?[\"'`]"]
  ],
  "tailwindCSS.classAttributes": [
    "class",
    "className",
    "ngClass",
    "ui",
    "active-class",
    "inactive-class"
  ],
  "cSpell.words": [
    "emailjs",
    "frite",
    "gesturestart",
    "gnubash",
    "grecaptcha",
    "takumi",
    "heroicons",
    "iconoir",
    "msbuild",
    "plusplus",
    "tabler"
  ],
  "github.copilot.chat.codeGeneration.instructions": [
    {
      "text": "This is a Nuxt 4 project (sources in app/). Use Vue 3 Composition API with TypeScript for the templating and the scripting. You can use VueUse utilities too. Use Nuxt UI 4 components and Tailwind 4 utilities for the design."
    }
  ],
}
