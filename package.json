{
  "name": "frites.dev",
  "version": "1.0.16",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "patch": "npm version patch --no-git-tag-version",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "upgrade": "nuxi upgrade",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "deploy": "firebase deploy"
  },
  "lint-staged": {
    "*.{ts,js,mjs,vue}": [
      "prettier --list-different",
      "eslint"
    ],
    "*.{css,json,yaml,yml}": [
      "prettier --list-different"
    ]
  },
  "devDependencies": {
    "@iconify-json/flag": "^1.2.12",
    "@iconify-json/iconoir": "^1.2.11",
    "@iconify-json/logos": "^1.2.14",
    "@iconify-json/simple-icons": "^1.2.97",
    "@iconify-json/tabler": "^1.2.40",
    "@iconify-json/tdesign": "^1.2.19",
    "@iconify-json/vscode-icons": "^1.2.82",
    "@nuxt/devtools": "^3.4.2",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/scripts": "^1.3.9",
    "@nuxt/ui": "^4.11.2",
    "@nuxtjs/seo": "^5.3.16",
    "@rollup/plugin-yaml": "^5.0.0",
    "@tailwindcss/forms": "^0.5.11",
    "@vue/test-utils": "^2.5.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "nuxt": "^4.5.2",
    "nuxt-security": "^2.6.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2",
    "vue": "latest",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@nuxt/test-utils": "^4.3.2",
    "@vueuse/components": "^15.0.0",
    "@vueuse/core": "^15.0.0",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "vue-demi@0.14.10": true,
    "esbuild@0.27.2": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
